# Copy to `.env.production` locally or set in Render → Environment.
# Public site origin for canonical URLs & JSON-LD (no trailing slash).
# VITE_PUBLIC_SITE_URL=https://your-service.onrender.com

# Optional: Google Maps iframe `src` from Maps → Share → Embed a map (recommended for production).
# If unset, the app uses a default HTTPS embed near the Arusha campus.
# VITE_MAP_EMBED_URL=https://www.google.com/maps/embed?pb=YOUR_EMBED_CODE
